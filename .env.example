# Production (set these in Vercel → Project → Settings → Environment Variables)

# Neon Postgres. Without this, the app uses an in-memory database (not durable on Vercel).
DATABASE_URL=

# Better Auth — required for stable sessions in production
BETTER_AUTH_SECRET=
# Public origin, e.g. https://iq-test.vercel.app
BETTER_AUTH_URL=

# Stripe (one-time €4.79 unlock). Without STRIPE_SECRET_KEY, preview unlock is used.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional: Grok auth broker (Google / X). Injected automatically on grok.me publishes.
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
